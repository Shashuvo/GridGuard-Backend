<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application approved</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #fbf6e3;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #2b2410;
      }
      table { border-collapse: collapse; }
      a { text-decoration: none; }

      .preheader {
        display: none;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .card {
        max-width: 480px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(184, 138, 0, 0.10), 0 12px 32px rgba(184, 138, 0, 0.12);
      }

      .brandbar {
        height: 6px;
        background: linear-gradient(90deg, #ffc400 0%, #ffb000 100%);
      }

      .content {
        padding: 36px 36px 32px;
      }

      .brandname {
        font-size: 17px;
        font-weight: 700;
        color: #8a6500;
        letter-spacing: -0.2px;
      }

      h1 {
        font-size: 22px;
        line-height: 1.35;
        margin: 20px 0 12px;
        color: #1a1400;
        font-weight: 650;
        text-align: center;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
        color: #5c5330;
      }

      .password-label {
        font-size: 13px;
        color: #7a7048;
        text-align: center;
        margin: 0 0 8px;
      }

      .password-box {
        margin: 0 0 20px;
        background-color: #fff8dc;
        border: 1px solid #f5e1a0;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
      }

      .password-code {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #8a6500;
        font-family: "SF Mono", Consolas, Menlo, monospace;
        word-break: break-all;
      }

      .alert-box {
        margin: 8px 0 4px;
        background-color: #fdf4ec;
        border: 1px solid #f2ddc4;
        border-radius: 10px;
        padding: 16px 18px;
      }

      .alert-box p {
        font-size: 13px;
        color: #8a5a1f;
        margin: 0;
        line-height: 1.6;
      }

      .divider {
        border: none;
        border-top: 1px solid #efe6c4;
        margin: 28px 0 24px;
      }

      .footer {
        padding: 24px 36px 32px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #a39a74;
        margin: 0;
      }

      @media (max-width: 520px) {
        .content { padding: 28px 24px 24px; }
        .footer { padding: 20px 24px 28px; }
        .password-code { font-size: 20px; }
      }
    </style>
  </head>
  <body>
    <div class="preheader">Your GridGuard technician application has been approved. Your temporary password is inside.</div>

    <table role="presentation" width="100%" class="wrapper">
      <tr>
        <td>
          <table role="presentation" class="card" width="100%">
            <tr>
              <td class="brandbar"></td>
            </tr>
            <tr>
              <td class="content">
                <table role="presentation">
                  <tr>
                    <td class="brandname">GridGuard</td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:28px;">
                  <tr>
                    <td align="center">
                      <table role="presentation" cellpadding="0" cellspacing="0">
                        <tr>
                          <td width="56" height="56" align="center" valign="middle" bgcolor="#ffc400" style="width:56px;height:56px;background-color:#ffc400;border-radius:28px;font-size:28px;line-height:56px;font-weight:700;color:#1a1400;">&#10003;</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <h1>Congratulations, <%= name %>!</h1>
                <p style="text-align:center;">Your application to join GridGuard as a technician has been reviewed and approved. Welcome to the team.</p>

                <p class="password-label">Your temporary password</p>
                <div class="password-box">
                  <span class="password-code"><%= password %></span>
                </div>

                <% if (locals.loginUrl) { %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center" style="padding:0 0 20px;">
                      <a href="<%= loginUrl %>" style="display:inline-block;background-color:#ffc400;color:#1a1400;font-size:15px;font-weight:700;padding:13px 28px;border-radius:10px;">Sign in</a>
                    </td>
                  </tr>
                </table>
                <% } %>

                <div class="alert-box">
                  <p><strong>Please log in and change your password immediately.</strong> Do not share this password with anyone.</p>
                </div>

                <hr class="divider" />

                <p style="font-size: 13px; color: #7a7048; margin: 0;">You can sign in using your registered email and the temporary password above.</p>
              </td>
            </tr>
            <tr>
              <td class="footer">
                <p>&copy; GridGuard. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>