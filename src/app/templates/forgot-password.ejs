<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset your password</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #fbf6e3;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #2b2410;
      }
      table { border-collapse: collapse; }
      a { text-decoration: none; }

      .preheader {
        display: none;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .card {
        max-width: 480px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(184, 138, 0, 0.10), 0 12px 32px rgba(184, 138, 0, 0.12);
      }

      .brandbar {
        height: 6px;
        background: linear-gradient(90deg, #ffc400 0%, #ffb000 100%);
      }

      .content {
        padding: 36px 36px 32px;
      }

      .brandname {
        font-size: 17px;
        font-weight: 700;
        color: #8a6500;
        letter-spacing: -0.2px;
      }

      h1 {
        font-size: 22px;
        line-height: 1.35;
        margin: 30px 0 12px;
        color: #1a1400;
        font-weight: 650;
        text-align: center;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
        color: #5c5330;
      }

      .otp-box {
        margin: 8px 0 12px;
        background-color: #fff8dc;
        border: 1px solid #f5e1a0;
        border-radius: 10px;
        padding: 22px 20px;
        text-align: center;
      }

      .otp-code {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #8a6500;
        font-family: "SF Mono", Consolas, Menlo, monospace;
      }

      .meta {
        font-size: 13px;
        color: #7a7048;
        margin: 0 0 20px;
        text-align: center;
      }

      .alert-box {
        margin: 8px 0 4px;
        background-color: #fdf4ec;
        border: 1px solid #f2ddc4;
        border-radius: 10px;
        padding: 16px 18px;
      }

      .alert-box p {
        font-size: 13px;
        color: #8a5a1f;
        margin: 0;
        line-height: 1.6;
      }

      .divider {
        border: none;
        border-top: 1px solid #efe6c4;
        margin: 28px 0 24px;
      }

      .footer {
        padding: 24px 36px 32px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #a39a74;
        margin: 0;
      }

      @media (max-width: 520px) {
        .content { padding: 28px 24px 24px; }
        .footer { padding: 20px 24px 28px; }
        .otp-code { font-size: 26px; letter-spacing: 7px; }
      }
    </style>
  </head>
  <body>
    <div class="preheader">Use this code to reset your GridGuard password. It expires in <%= expirationMinutes %> minutes.</div>

    <table role="presentation" width="100%" class="wrapper">
      <tr>
        <td>
          <table role="presentation" class="card" width="100%">
            <tr>
              <td class="brandbar"></td>
            </tr>
            <tr>
              <td class="content">
                <table role="presentation">
                  <tr>
                    <td class="brandname">GridGuard</td>
                  </tr>
                </table>

                <h1>Reset your password</h1>
                <p style="text-align:center;">Hi <%= name %>, we received a request to reset the password for your GridGuard account. Use the code below to continue.</p>

                <div class="otp-box">
                  <span class="otp-code"><%= otp %></span>
                </div>
                <p class="meta">This code expires in <%= expirationMinutes %> minutes.</p>

                <% if (locals.resetUrl) { %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center" style="padding:0 0 20px;">
                      <a href="<%= resetUrl %>" style="display:inline-block;background-color:#ffc400;color:#1a1400;font-size:15px;font-weight:700;padding:13px 28px;border-radius:10px;">Reset password</a>
                    </td>
                  </tr>
                </table>
                <% } %>

                <div class="alert-box">
                  <p>If you didn't request a password reset, you can safely ignore this email — your password will stay the same.</p>
                </div>

                <hr class="divider" />

                <p style="font-size: 13px; color: #7a7048; margin: 0;">For your security, never share this code with anyone, including GridGuard staff and technicians.</p>
              </td>
            </tr>
            <tr>
              <td class="footer">
                <p>&copy; GridGuard. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>