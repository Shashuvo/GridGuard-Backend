<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application update</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #fbf6e3;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #2b2410;
      }
      table { border-collapse: collapse; }
      a { text-decoration: none; }

      .preheader {
        display: none;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .card {
        max-width: 480px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(184, 138, 0, 0.10), 0 12px 32px rgba(184, 138, 0, 0.12);
      }

      .brandbar {
        height: 6px;
        background: linear-gradient(90deg, #ffc400 0%, #ffb000 100%);
      }

      .content {
        padding: 36px 36px 32px;
      }

      .brandname {
        font-size: 17px;
        font-weight: 700;
        color: #8a6500;
        letter-spacing: -0.2px;
      }

      h1 {
        font-size: 22px;
        line-height: 1.35;
        margin: 30px 0 12px;
        color: #1a1400;
        font-weight: 650;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
        color: #5c5330;
      }

      .divider {
        border: none;
        border-top: 1px solid #efe6c4;
        margin: 28px 0 24px;
      }

      .footer {
        padding: 24px 36px 32px;
        text-align: center;
      }

      .footer p {
        font-size: 12px;
        color: #a39a74;
        margin: 0;
      }

      @media (max-width: 520px) {
        .content { padding: 28px 24px 24px; }
        .footer { padding: 20px 24px 28px; }
      }
    </style>
  </head>
  <body>
    <div class="preheader">An update on your GridGuard application.</div>

    <table role="presentation" width="100%" class="wrapper">
      <tr>
        <td>
          <table role="presentation" class="card" width="100%">
            <tr>
              <td class="brandbar"></td>
            </tr>
            <tr>
              <td class="content">
                <table role="presentation">
                  <tr>
                    <td class="brandname">GridGuard</td>
                  </tr>
                </table>

                <h1>Application update</h1>
                <p>Hi <%= name %>, thank you for applying to GridGuard. We appreciate the time you took to apply.</p>
                <p>After reviewing your application, we are unable to approve it at this time.</p>

                <% if (locals.reason && reason) { %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate;border-spacing:0;margin:8px 0 8px;background-color:#fdf2f2;border:1px solid #f5d0d0;border-left:4px solid #e02424;border-radius:10px;">
                  <tr>
                    <td style="padding:16px 18px;">
                      <div style="font-size:13px;font-weight:700;color:#611a15;padding-bottom:4px;">Reason</div>
                      <div style="font-size:14px;line-height:1.6;color:#611a15;"><%= reason %></div>
                    </td>
                  </tr>
                </table>
                <% } %>

                <hr class="divider" />

                <p style="font-size: 13px; color: #7a7048; margin: 0;">If you have any questions about this decision, please contact our support team.</p>
              </td>
            </tr>
            <tr>
              <td class="footer">
                <p>&copy; GridGuard. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>